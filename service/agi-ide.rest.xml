<?xml version="1.0" encoding="UTF-8"?>
<rest-api xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
          name="agi-ide" version="s1" require-csrf="false" require-authentication="false">
    
    <resource name="getBlueprint">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.get#Blueprint"/>
        </method>
    </resource>

    <resource name="saveBlueprint">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.save#Blueprint"/>
        </method>
    </resource>

    <resource name="registerClient">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.register#Client"/>
        </method>
    </resource>

    <resource name="getUiMacros">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.get#UiMacros"/>
        </method>
    </resource>

    <resource name="compileRawXmlToBlueprint">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.compile#RawXmlToBlueprint"/>
        </method>
    </resource>

    <!-- Secure rest channel hook for automated agent interactions -->
    <resource name="scaffoldComponent">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ide.ScreenEditorServices.create#NewComponentScaffold"/>
        </method>
    </resource>

    <resource name="getAllTools">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ide.AgiMcpServices.getAllTools"/>
        </method>
    </resource>

    <resource name="geminiProxy">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ide.AgiMcpServices.executeAdkProxyLoop"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!--  AGI HARNESS & TELEMETRY REST ENDPOINTS                    -->
    <!-- ========================================================= -->

    <!-- Telemetry Summary for At-a-Glance Agent Context -->
    <resource name="telemetry">
        <resource name="summary">
            <method type="get" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.get#ArtifactTelemetrySummary"/>
            </method>
        </resource>
    </resource>

    <!-- Blueprint WorkEffort Tree & Node Operations -->
    <resource name="blueprint">
        <resource name="tree">
            <method type="post" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.get#BlueprintArtifactTree"/>
            </method>
        </resource>
        <resource name="create-node">
            <method type="post" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.create#WorkEffortNode"/>
            </method>
        </resource>
        <resource name="update-status">
            <method type="post" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.update#WorkEffortStatus"/>
            </method>
        </resource>
        <resource name="link-artifact">
            <method type="post" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.associate#WorkEffortToArtifact"/>
            </method>
        </resource>
        <resource name="query-artifacts">
            <method type="get" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.get#ArtifactQueryList"/>
            </method>
        </resource>
        <resource name="compile-xml">
            <method type="post" require-authentication="false">
                <service name="org.moqui.ide.BlueprintServices.compile#XmlFragment"/>
            </method>
        </resource>
    </resource>

    <resource name="component">
        <resource name="create">
            <method type="post">
                <service name="org.moqui.ide.ComponentServices.create#Component"/>
            </method>
        </resource>
    </resource>

    <resource name="screen">
        <resource name="create">
            <method type="post">
                <service name="org.moqui.ai.mcp.MCPScreenServices.create#Screen"/>
            </method>
        </resource>
    </resource>

    <!-- Artifact Discovery & Palette REST Endpoint -->
    <resource name="palette">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ai.mcp.MCPArtifactServices.get#ArtifactPalette"/>
        </method>
    </resource>

    <!-- Composite Layout & Navigation MCP Tools -->
    <resource name="add-container">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ai.mcp.MCPScreenServices.add#Container"/>
        </method>
    </resource>

    <resource name="bind-subscreen">
        <method type="post" require-authentication="false">
            <service name="org.moqui.ai.mcp.MCPScreenServices.bind#Subscreen"/>
        </method>
    </resource>

    <resource name="getRawXml">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ai.mcp.MCPScreenServices.get#RawXml"/>
        </method>
    </resource>

    <resource name="getKnownArtifacts">
        <method type="get" require-authentication="false">
            <service name="org.moqui.ide.AgiWorkspaceServices.get#KnownArtifacts"/>
        </method>
    </resource>

    <resource name="getWorkspaceBuffer">
        <method type="get">
            <service name="org.moqui.ide.AgiWorkspaceServices.get#WorkspaceBuffer"/>
            <param name="artifactUri" type="String" required="true"/>
            <param name="userId" type="String"/>
        </method>
    </resource>
    <resource name="storeWorkspaceBuffer">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.store#WorkspaceBuffer"/>
        </method>
    </resource>
    <resource name="compileTreeToXml" require-authentication="anonymous-all">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.compile#TreeToXml"/>
            <param name="layoutTree" type="Map" required="false"/>
        </method>
    </resource>
    <resource name="saveScreenXml" require-authentication="anonymous-all">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.save#ScreenXml"/>
            <param name="artifactUri" type="String" required="true"/>
            <param name="metaJsonBuffer" type="String" required="true"/>
        </method>
    </resource>
</rest-api>