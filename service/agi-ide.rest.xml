<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
          name="agi-ide" version="s1" require-csrf="false" require-authentication="false">

    <!-- ========================================================= -->
    <!-- SCREEN EDITOR & BLUEPRINT BASE SERVICES                  -->
    <!-- ========================================================= -->
    <resource name="getBlueprint">
        <method type="get">
            <service name="org.moqui.ide.ScreenEditorServices.get#Blueprint"/>
        </method>
    </resource>

    <resource name="saveBlueprint">
        <method type="post">
            <service name="org.moqui.ide.ScreenEditorServices.save#Blueprint"/>
        </method>
    </resource>

    <resource name="registerClient">
        <method type="get">
            <service name="org.moqui.ide.ScreenEditorServices.register#Client"/>
        </method>
    </resource>

    <resource name="getUiMacros">
        <method type="get">
            <service name="org.moqui.ide.ScreenEditorServices.get#UiMacros"/>
        </method>
    </resource>

    <resource name="compileRawXmlToBlueprint">
        <method type="post">
            <service name="org.moqui.ide.ScreenEditorServices.compile#RawXmlToBlueprint"/>
        </method>
    </resource>

    <resource name="scaffoldComponent">
        <method type="post">
            <service name="org.moqui.ide.ScreenEditorServices.create#NewComponentScaffold"/>
        </method>
    </resource>

    <resource name="getAllTools">
        <method type="get">
            <service name="org.moqui.ide.AgiMcpServices.getAllTools"/>
        </method>
    </resource>

    <resource name="geminiProxy">
        <method type="post">
            <service name="org.moqui.ide.AgiMcpServices.executeAdkProxyLoop"/>
        </method>
    </resource>

    <resource name="openAiProxy">
        <method type="post">
            <service name="org.moqui.ide.AgiMcpServices.run#OpenAiProxy"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- AGI HARNESS & TELEMETRY REST ENDPOINTS                    -->
    <!-- ========================================================= -->
    <resource name="telemetry">
        <resource name="summary">
            <method type="get">
                <service name="org.moqui.ide.BlueprintServices.get#ArtifactTelemetrySummary"/>
            </method>
        </resource>
    </resource>

    <resource name="blueprint">
        <resource name="tree">
            <method type="post">
                <service name="org.moqui.ide.BlueprintServices.get#BlueprintArtifactTree"/>
            </method>
        </resource>
        <resource name="create-node">
            <method type="post">
                <service name="org.moqui.ide.BlueprintServices.create#WorkEffortNode"/>
            </method>
        </resource>
        <resource name="update-status">
            <method type="post">
                <service name="org.moqui.ide.BlueprintServices.update#WorkEffortStatus"/>
            </method>
        </resource>
        <resource name="link-artifact">
            <method type="post">
                <service name="org.moqui.ide.BlueprintServices.associate#WorkEffortToArtifact"/>
            </method>
        </resource>
        <resource name="query-artifacts">
            <method type="get">
                <service name="org.moqui.ide.BlueprintServices.get#ArtifactQueryList"/>
            </method>
        </resource>
        <resource name="compile-xml">
            <method type="post">
                <service name="org.moqui.ide.BlueprintServices.compile#XmlFragment"/>
            </method>
        </resource>
    </resource>

    <resource name="component">
        <resource name="create">
            <method type="post">
                <service name="org.moqui.ide.ComponentServices.create#Component"/>
            </method>
        </resource>
    </resource>

    <resource name="screen">
        <resource name="create">
            <service name="org.moqui.ai.mcp.McpScreenServices.create#Screen"/>
        </resource>
    </resource>

    <resource name="palette">
        <method type="get">
            <service name="org.moqui.ai.mcp.McpArtifactServices.get#ArtifactPalette"/>
        </method>
    </resource>

    <resource name="add-container">
        <method type="post">
            <service name="org.moqui.ai.mcp.McpScreenServices.add#Container"/>
        </method>
    </resource>

    <resource name="bind-subscreen">
        <method type="post">
            <service name="org.moqui.ai.mcp.McpScreenServices.bind#Subscreen"/>
        </method>
    </resource>

    <resource name="getRawXml">
        <method type="get">
            <service name="org.moqui.ai.mcp.McpScreenServices.get#RawXml"/>
        </method>
    </resource>

    <resource name="getKnownArtifacts">
        <method type="get">
            <service name="org.moqui.ide.AgiWorkspaceServices.get#KnownArtifacts"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- WORKSPACE BUFFER & AST OPERATIONS                        -->
    <!-- ========================================================= -->
    <resource name="getWorkspaceBuffer">
        <method type="get">
            <service name="org.moqui.ide.AgiWorkspaceServices.get#WorkspaceBuffer"/>
        </method>
    </resource>

    <resource name="storeWorkspaceBuffer">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.store#WorkspaceBuffer"/>
        </method>
    </resource>

    <resource name="clearWorkspaceBuffer">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.clear#WorkspaceBuffer"/>
        </method>
    </resource>

    <resource name="compileTreeToXml">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.compile#TreeToXml"/>
        </method>
    </resource>

    <resource name="saveScreenXml">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.save#ScreenXml"/>
        </method>
    </resource>

    <resource name="deleteArtifact">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.delete#WorkspaceArtifact"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- RAG & AGENT STAGING SERVICES                              -->
    <!-- ========================================================= -->
    <resource name="preprocessRagContext">
        <method type="post">
            <service name="org.moqui.ai.AgiRagServices.preprocess#RagContext"/>
        </method>
    </resource>

    <resource name="executeStagedAgentTurn">
        <method type="post">
            <service name="org.moqui.ai.AgiRagServices.execute#StagedAgentTurn"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- WIKI & THEME ARTIFACTS                                    -->
    <!-- ========================================================= -->
    <resource name="getWikiTreeNodes">
        <method type="get">
            <service name="org.moqui.ide.AgiWikiTreeServices.get#WikiTreeNodes"/>
        </method>
        <method type="post">
            <service name="org.moqui.ide.AgiWikiTreeServices.get#WikiTreeNodes"/>
        </method>
    </resource>

    <resource name="saveWikiNode">
        <method type="post">
            <service name="org.moqui.ide.AgiWikiTreeServices.save#WikiNode"/>
        </method>
    </resource>

    <resource name="saveThemeJson">
        <method type="post">
            <service name="org.moqui.ide.AgiWorkspaceServices.save#ThemeJson"/>
        </method>
    </resource>

    <resource name="getThemeJson">
        <method type="get">
            <service name="org.moqui.ide.AgiWorkspaceServices.get#ThemeJson"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- SERVICE & ENTITY BLUEPRINT ENDPOINTS                      -->
    <!-- ========================================================= -->
    <resource name="getScreenEntityGrounding">
        <method type="get">
            <service name="org.moqui.ide.AgiEntityServices.get#ScreenEntityGrounding"/>
        </method>
    </resource>

    <resource name="getServiceBlueprint">
        <method type="get">
            <service name="org.moqui.ai.AgiServiceServices.get#ServiceBlueprint"/>
        </method>
    </resource>

    <resource name="saveServiceXml">
        <method type="post">
            <service name="org.moqui.ai.AgiServiceServices.save#ServiceXml"/>
        </method>
    </resource>

    <resource name="testServiceExecution">
        <method type="post">
            <service name="org.moqui.ai.AgiServiceServices.test#ServiceExecution"/>
        </method>
    </resource>

    <resource name="getEntityBlueprint">
        <method type="get">
            <service name="org.moqui.ide.AgiEntityServices.get#EntityBlueprint"/>
        </method>
    </resource>

    <resource name="saveEntityXml">
        <method type="post">
            <service name="org.moqui.ide.AgiEntityServices.save#EntityXml"/>
        </method>
    </resource>

    <resource name="queryEntityData">
        <method type="get">
            <service name="org.moqui.ide.AgiEntityServices.query#EntityData"/>
        </method>
    </resource>

    <!-- ========================================================= -->
    <!-- MCP PROTOCOL REST API                                     -->
    <!-- Endpoints:                                                -->
    <!--   GET    /rest/s1/agi-ide/mcp/resources                   -->
    <!--   GET    /rest/s1/agi-ide/mcp/resources/content           -->
    <!--   POST   /rest/s1/agi-ide/mcp/resources/facet             -->
    <!--   DELETE /rest/s1/agi-ide/mcp/resources/facet             -->
    <!--   GET    /rest/s1/agi-ide/mcp/tools                       -->
    <!--   POST   /rest/s1/agi-ide/mcp/tools/call                  -->
    <!-- ========================================================= -->
    <resource name="mcp">
        <resource name="resources">
            <method type="get">
                <service name="org.moqui.ai.mcp.McpResourceServices.get#ResourceList"/>
            </method>

            <resource name="content">
                <method type="get">
                    <service name="org.moqui.ai.mcp.McpResourceServices.get#ResourceContent"/>
                </method>
            </resource>

            <resource name="facet">
                <method type="post">
                    <service name="org.moqui.ai.mcp.McpResourceServices.set#ResourceFacet"/>
                </method>
                <method type="delete">
                    <service name="org.moqui.ai.mcp.McpResourceServices.delete#ResourceFacet"/>
                </method>
            </resource>
        </resource>

        <resource name="tools">
            <method type="get">
                <service name="org.moqui.ai.mcp.McpToolServices.get#ToolList"/>
            </method>

            <resource name="call">
                <method type="post">
                    <service name="org.moqui.ai.mcp.McpToolServices.call#Tool"/>
                </method>
            </resource>
        </resource>
        <resource name="runService">
            <method type="post"><service name="org.moqui.ai.AgiServiceServices.run#Service"/></method>
        </resource>
    </resource>

    <resource name="validateScreenXml">
        <method type="post">
            <service name="validate#ScreenXml"/>
        </method>
    </resource>

    <!-- ===================================================================== -->
    <!-- IN-APP TEST RUNNER ENDPOINTS                                          -->
    <!-- ===================================================================== -->
    <resource name="getTestManifests">
        <method type="get">
            <service name="org.moqui.ide.AgiTestRunnerServices.get#TestManifests"/>
        </method>
    </resource>

    <resource name="assertArtifactState">
        <method type="get">
            <service name="org.moqui.ide.AgiTestRunnerServices.assert#ArtifactState"/>
        </method>
    </resource>
    <resource name="deleteArtifactCascade">
        <method type="post"><service name="org.moqui.ide.BlueprintServices.delete#ArtifactCascade"/></method>
    </resource>
</resource>