<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false"
        standalone="true"
        default-subscreen="AgiWorkspace">

    <!-- 🎯 Keep only the explicit text/qmeta compiler macro active -->
    <macro-template type="html" location="component://agi-ai/template/screen-macro/DefaultScreenMacros.qmeta.ftl"/>

    <transition name="getFormMetadata" read-only="true" >
        <actions>
            <set field="activeUserId" from="ec.user.getUserId()" />
            <log message="In getFormMetadata, userId: ${activeUserId}" />
            <service-call name="org.moqui.ide.AgiMcpServices.get#FormMetadata" 
                          in-map="[screenPath: screenPath, userId:activeUserId]" 
                          out-map="context"/>
            <script>
                ec.web.sendJsonResponse([metadataJson: metadataJson])
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <pre-actions>
        <script><![CDATA[
            // Route asset calls smoothly over your streaming macro endpoint
            html_stylesheets.add('/agi-ide-include/agi-ide.css')
        ]]></script>
        <!--
        <script location="component://agi-ide/script/AgiBootstrapper.groovy"/>
        -->
    </pre-actions>

    <always-actions>
        <script>
            ec.web.response.setContentType("text/html; charset=UTF-8")
        </script>
    </always-actions>

    <subscreens default-item="AgiWorkspace">
        <subscreens-item name="AgiDashboard" location="component://agi-ide/screen/agi-ide/AgiDashboard.xml"/>
        <subscreens-item name="AgiWorkspace" location="component://agi-ide/screen/agi-ide/AgiWorkspace.xml"/>
        <subscreens-item name="AgiInstructions" location="component://agi-ide/screen/agi-ide/AgiInstructions.xml"/>
    </subscreens>

    <!-- 🎯 FIX: Wrapped children cleanly into the macro output block -->
    <widgets>
                <screen-layout view="hHh lpR fFf">
                    <screen-header elevated="true" />
                    <screen-content>
                        <subscreens-active/>
                    </screen-content>
                </screen-layout>
    </widgets>
</screen>