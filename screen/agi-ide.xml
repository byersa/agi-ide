<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false"
        standalone="true"
        default-subscreen="Develop">

    <macro-template type="html" location="component://agi-ai/template/screen-macro/DefaultScreenMacros.qmeta.ftl"/>

    <transition name="getFormMetadata" read-only="true">
        <actions>
            <set field="activeUserId" from="ec.user.getUserId() ?: 'system_ide_user'"/>
            <service-call name="org.moqui.ide.AgiMcpServices.get#FormMetadata" 
                          in-map="[screenPath: screenPath, userId: activeUserId]" 
                          out-map="context"/>
            <script>
                ec.web.sendJsonResponse([metadataJson: metadataJson])
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <pre-actions>
        <script><![CDATA[
            html_stylesheets.add('/agi-ide-include/agi-ide.css')
            // Guard window.AgiComponents against reserved SVG/HTML tags before FTL bootstrap executes
            html_scripts.add('/agi-ide-assets/util/sanitize-components.js')
        ]]></script>
    </pre-actions>

    <always-actions>
        <set field="activeUserId" from="ec.user.userId ?: 'system_ide_user'"/>
        <script><![CDATA[
            ec.web.response.setContentType("text/html; charset=UTF-8")
        ]]></script>
    </always-actions>

    <subscreens default-item="Develop">
        <subscreens-item name="Home" location="component://agi-ide/screen/agi-ide/Home.xml"/>
        <subscreens-item name="Production" location="component://agi-ide/screen/agi-ide/Production.xml"/>
        <subscreens-item name="Develop" location="component://agi-ide/screen/agi-ide/AgiWorkspace.xml"/>
        <!-- Backward compatibility alias -->
        <subscreens-item name="AgiWorkspace" location="component://agi-ide/screen/agi-ide/AgiWorkspace.xml"/>
        <subscreens-item name="Documentation" location="component://agi-ide/screen/agi-ide/Documentation.xml"/>
        <subscreens-item name="AgiDashboard" location="component://agi-ide/screen/agi-ide/AgiDashboard.xml"/>
        <subscreens-item name="AgiInstructions" location="component://agi-ide/screen/agi-ide/AgiInstructions.xml"/>
        <subscreens-item name="TestLlm" location="component://agi-ide/screen/agi-ide/TestLlm.xml"/>
    </subscreens>

    <widgets>
        <screen-layout view="hHh lpR fFf">
            <screen-header elevated="false" style="background-color: #020617; border-bottom: 1px solid #1e293b; height: 42px; min-height: 42px;">
                <container style="row items-center justify-between full-width font-mono bg-black text-white q-px-md" style-extra="height: 42px; background-color: #020617; border-bottom: 1px solid #1e293b;">
                    <!-- LEFT: BRAND -->
                    <container style="row items-center q-gutter-x-sm">
                        <label text="memory" style="font-size: 20px; font-family: 'Material Icons'; color: #22d3ee;"/>
                        <label text="MoquiAI" style="text-subtitle1 text-weight-bolder text-cyan-3"/>
                    </container>
                
                    <!-- CENTER: PRIMARY NAVIGATION -->
                    <container style="row items-center q-gutter-x-xs text-caption">
                        <link url="/agi-ide/Home" text="Home" 
                              style="q-px-sm text-grey-4"/>
                        <link url="javascript:void(0)" text="Production" 
                              link-type="anchor"
                              style="q-px-sm text-grey-4" 
                              tooltip="Launch production preview in dedicated tab">
                            <parameter name="onclick" value="window.openProductionPreview ? window.openProductionPreview() : window.open('/apps/nursinghome', 'moqui-production-preview'); return false;"/>
                        </link>
                        <link url="/agi-ide/Develop" text="Develop" 
                              style="text-weight-bolder q-px-sm text-cyan-2 bg-grey-10" 
                              style-extra="border: 1px solid #0284c7;"/>
                        <link url="/agi-ide/Documentation" text="Documentation" 
                              style="q-px-sm text-grey-4"/>
                    </container>
                
                    <!-- RIGHT: USER & VERSION -->
                    <container style="row items-center q-gutter-x-sm">
                        <label text="${activeUserId}" style="text-caption text-grey-4"/>
                        <container style="bg-cyan-9 rounded-borders q-px-xs text-weight-bold">
                            <label text="v1.0" style="text-white"/>
                        </container>
                    </container>
                </container>
            </screen-header>

            <screen-content>
                <subscreens-active/>
            </screen-content>
        </screen-layout>
    </widgets>
</screen>