<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="component://agi-ai/xsd/agi-screen-1.0.xsd"
        require-authentication="true">

    <subscreens>
        <subscreen name="AgiCanvasEditor" location="component://agi-ide/screen/agi-ide/AgiCanvasEditor.xml"/>
        <subscreen name="AgiScreenEditor" location="component://agi-ide/screen/agi-ide/AgiScreenEditor.xml"/>
        <subscreen name="AgiComponentEditor" location="component://agi-ide/screen/agi-ide/AgiComponentEditor.xml"/>
    </subscreens>

    <widgets>



        <container id="agi-workspace-root" 
                   type="agi-workspace" 
                   style="screen-path='${screenPath}'">
        </container>

    </widgets>
</screen>