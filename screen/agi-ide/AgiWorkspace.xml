<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-4.0.xsd"
        require-authentication="true">

    <parameter name="screenPath"/>

    <pre-actions>
        <script><![CDATA[
            // Forces Moqui to bypass standard 'html' macro rendering for this screen footprint
            sri.renderMode("qmeta")
        ]]></script>
        <script location="component://agi-ide/script/AgiBootstrapper.groovy"/>
    </pre-actions>

    <widgets>
        <container id="agi-workspace-container">
            <render-mode>
                <text type="html"><![CDATA[
                    <agi-workspace ></agi-workspace>
                ]]></text>
            </render-mode>
        </container>
    </widgets>
</screen>