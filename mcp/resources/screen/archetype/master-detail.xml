<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Master Detail View"
        description="Master entity summary card on top with multiple related detail form-lists below">

    <parameter name="partyId" required="true"/>

    <actions>
        <entity-find-one entity-name="mantle.party.Person" value-field="person">
            <field-map field-name="partyId"/>
        </entity-find-one>
    </actions>

    <widgets>
        <container-box style="q-mb-md">
            <box-header title="Primary Details"/>
            <box-body>
                <form-single name="MasterSummaryForm" map="person">
                    <field name="partyId"><default-field title="ID"><display/></default-field></field>
                    <field name="firstName"><default-field title="First Name"><display/></default-field></field>
                    <field name="lastName"><default-field title="Last Name"><display/></default-field></field>
                </form-single>
            </box-body>
        </container-box>

        <container-box>
            <box-header title="Related List"/>
            <box-body>
                <form-list name="DetailList" list="detailList" skip-form="true">
                    <field name="itemDescription"><default-field title="Description"><display/></default-field></field>
                </form-list>
            </box-body>
        </container-box>
    </widgets>
</screen>